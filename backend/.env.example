# Copy to .env and adjust. All settings are optional in dev (sensible defaults exist).
BASEERAH_ENVIRONMENT=development
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# BASEERAH_SECRET_KEY=change-me
# BASEERAH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# BASEERAH_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/baseerah
# BASEERAH_ANOMALY_Z_THRESHOLD=2.0
# BASEERAH_LEAK_RATIO_THRESHOLD=1.4
